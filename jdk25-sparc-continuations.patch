+  __ st_ptr(G1, SP, STACK_BIAS + in_bytes(ContinuationEntry::parent_offset()));
+  __ add(SP, STACK_BIAS, G1);
+  __ st_ptr(G1, G2_thread, in_bytes(JavaThread::cont_entry_offset()));
+  fill_continuation_entry(masm);
