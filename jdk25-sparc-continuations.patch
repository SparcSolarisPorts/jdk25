+                  CAST_FROM_FN_PTR(address, SharedRuntime::exception_handler_for_return_address),
+                  G2_thread, L1);
+  __ mov(O0, G1);
+  __ mov(L0, I0);
+  __ mov(L1, I1);
+  __ jmp(G1, 0);
+  __ delayed()->restore();
+}
